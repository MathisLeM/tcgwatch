# ---- Secrets / env ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Local database (regenerated by the scraper / migration) ----
data/tcg_stock.sqlite
data/tcg_stock.sqlite-*
*.sqlite
*.sqlite3

# ---- Working data artifacts (keep data/reference/, drop the rest) ----
data/*.xlsx
data/discovered_*.xlsx
data/discovered_*.csv
data/ignored_products.json
data/OP26062026/
data/backups/
data/OP*/
data/optcg_promo_packs.*
data/products_view.xlsx
data/review_*.xlsx
# keep curated reference data under version control
!data/reference/
!data/extra_shops.json
!data/pokemon_catalog.xlsx
# ...but drop the heavy, build-time-only reference dumps (regenerable; not needed
# by the deployed API — they only feed local catalog/promo rebuild scripts).
data/reference/cardmarket/
data/reference/limitless_promo_cache/
data/reference/tcgplayer_*.json

# ---- Cardmarket raw inputs (large; ingested locally into the DB via
#      scraper.cardmarket.ingest — not needed in the repo). Keep the small
#      tracked_*.json seed lists under version control. ----
data/cardmarket/price_guide/
data/cardmarket/products_singles_*.json
data/cardmarket/products_nonsingles_*.json

# ---- Valuation model: raw apitcg per-set dumps are regenerable (keyless
#      GitHub mirror). Keep the small consolidated optcg_cards.json committed
#      so the pipeline + tests run offline. ----
data/valuation/apitcg/
data/valuation/limitless/

# ---- Playwright/POC debug captures (screenshots, HTML dumps) ----
scraper/poc/*.png
scraper/poc/*.html
store_stock_poc/*.png

# ---- Images ----
# Ignore all images EXCEPT the curated Pokemon reference logos (block / set), which
# the alpha serves directly from Railway's /images static mount (~10 MB, version-
# controlled). Cloudflare R2 remains the scale path for the full image set.
images/*
!images/Pokemon/
images/Pokemon/*
!images/Pokemon/Image_block/
!images/Pokemon/Image_Serie/
!images/Pokemon/Image_Serie_auto/
!images/Pokemon/Image_Serie_pokecardex/
# OPTCG / Naruto set images live at the images/ root, named "<SETCODE><suffix>.<ext>"
# (BB=display, SB=booster, SPC=case). Ship them for the alpha catalogue.
!images/OP*
!images/EB*
!images/PRB*
!images/NRT*

# ---- Node / Next.js (frontend) ----
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/next-env.d.ts
node_modules/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# valuation EDA charts (regenerable)
data/valuation/analysis/
