# ============================================================================
# TCGWatch — environment template.  Copy to .env and fill in.
#   cp .env.example .env
# Secrets live in the Railway / Vercel dashboards in production — never commit .env.
# ============================================================================

# -- Environment --------------------------------------------------------------
# "production" enables strict startup checks (crashes if SECRET_KEY is a placeholder).
ENVIRONMENT=development

# -- Database -----------------------------------------------------------------
# Local dev: reuse the scraper's existing SQLite DB.
DATABASE_URL=sqlite:///./data/tcg_stock.sqlite
# Production (Supabase): postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# -- API server ---------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# -- CORS — comma-separated list of allowed frontend origins ------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -- Auth ---------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-use-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Alpha: public self-signup is closed — provision accounts with
#   python -m scripts.manage_users create <email>
# Set to true to reopen POST /auth/signup (and NEXT_PUBLIC_ALLOW_SIGNUP=true on the frontend).
ALLOW_PUBLIC_SIGNUP=false

# -- Scraper worker scheduler -------------------------------------------------
# How often the worker runs a full scrape, and which games.
SCRAPE_INTERVAL_HOURS=6
SCRAPE_GAMES=all

# -- Alerting: Email (SMTP) ---------------------------------------------------
# Leave SMTP_HOST empty to disable email sending (dry-run logs only).
# Gmail: host=smtp.gmail.com port=587 user=you@gmail.com pass=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=TCGWatch <alertes@tcgwatch.app>

# -- Alerting: Discord --------------------------------------------------------
# Optional default/global webhook for system notifications (per-user webhooks are stored in DB).
DISCORD_WEBHOOK_URL=

# -- Frontend URL (used to build links in emails) -----------------------------
APP_URL=http://localhost:3000

# -- Cloudflare R2 (S3-compatible) — image storage ----------------------------
# Leave R2_BUCKET empty to fall back to serving local /images in dev.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tcgwatch-images
# Public base URL for the bucket (custom domain or r2.dev URL), e.g. https://img.tcgwatch.app
R2_PUBLIC_BASE_URL=
